# Copy this file to ".env" in the project root to override defaults.
# PhishGuard works without any .env file. There are NO API keys and no secrets here.

# Browser origins allowed to call the API (comma-separated). Never use "*".
PHISHGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite file and trained-model folder (defaults shown are relative to the backend folder).
# PHISHGUARD_DB_PATH=
# PHISHGUARD_MODEL_DIR=

# Basic abuse protection (per client IP) and maximum request size in bytes.
PHISHGUARD_RATE_LIMIT_PER_MINUTE=120
PHISHGUARD_MAX_BODY_BYTES=100000

# Leave empty to use the SQLite file at PHISHGUARD_DB_PATH.
# Set a Postgres URL to keep scan history on hosts with an ephemeral filesystem.
# Vercel's Postgres integrations provide DATABASE_URL automatically.
PHISHGUARD_DATABASE_URL=
